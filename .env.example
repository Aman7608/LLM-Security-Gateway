# Copy this file to .env and change the values you need:
#   Copy-Item .env.example .env
# .env is ignored by git, so your real keys stay on your computer.
# Every setting is optional. With no .env at all, the gateway uses the mock AI.

# --- General ---
GATEWAY_ENVIRONMENT=development      # development, test or production
GATEWAY_LOG_LEVEL=INFO               # DEBUG, INFO, WARNING or ERROR
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# --- Files and storage ---
GATEWAY_POLICY_FILE=config/policy.yaml
GATEWAY_INJECTION_RULES_FILE=config/injection_rules.yaml
GATEWAY_PII_ENTITIES_FILE=config/pii_entities.yaml
GATEWAY_SECRET_PATTERNS_FILE=config/secret_patterns.yaml
GATEWAY_CONFIDENTIAL_TERMS_FILE=config/confidential_terms.yaml
GATEWAY_DATABASE_URL=sqlite:///./data/gateway.db

# --- AI providers ---
GATEWAY_DEFAULT_PROVIDER=mock        # mock, openai or anthropic
# Only needed if you use a real provider. Never commit real keys.
# Real providers also need: pip install -r requirements-providers.txt
GATEWAY_OPENAI_API_KEY=
GATEWAY_OPENAI_MODEL=                # required for OpenAI, e.g. the model your account uses
GATEWAY_ANTHROPIC_API_KEY=
GATEWAY_ANTHROPIC_MODEL=claude-opus-5-5
GATEWAY_ANTHROPIC_EFFORT=medium      # low, medium, high, xhigh or max
GATEWAY_ANTHROPIC_REFUSAL_FALLBACKS=true
GATEWAY_PROVIDER_TIMEOUT_SECONDS=120 # per attempt
GATEWAY_PROVIDER_MAX_RETRIES=2

# --- API limits ---
GATEWAY_RATE_LIMIT_PER_MINUTE=60     # requests per API key per minute
GATEWAY_MAX_REQUEST_BYTES=1000000    # bigger requests get 413
GATEWAY_MAX_REQUEST_CHARS=50000      # all messages + documents of one chat

# --- Security behaviour ---
GATEWAY_FAIL_MODE=closed             # closed = block if a check crashes (safer)
GATEWAY_MAX_PROMPT_CHARS=20000
GATEWAY_STORE_REDACTED_PROMPTS=false # true = keep the REDACTED prompt in the audit log
GATEWAY_LOG_RETENTION_DAYS=30        # audit events older than this are deleted
# true = answer 503 if the audit log cannot be saved; false = log to the console and go on
GATEWAY_AUDIT_REQUIRED=false
# Shown instead of an AI answer that was blocked
GATEWAY_OUTPUT_BLOCKED_MESSAGE="The answer was withheld by the security gateway because it may contain sensitive information."
# Required in production, at least 32 characters. Make one with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_FINGERPRINT_KEY=
